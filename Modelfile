# InfraBrain Production Modelfile — Technical Lead & Execution Specialist
# Role: default (infrabrain) — primary orchestrator for all DPEV loop tasks
# Target hardware: 1x NVIDIA RTX 5090 (32 GB VRAM)
# Strategy: Domain Expertise over Parameter Count — Qwen 32B is the Technical Lead
#   because IT-Ops is structured syntax (CLI, logs, configs) where code specialists dominate
# 32k High-Density Context + TOON encoding = ~50k+ effective standard tokens
#
# Model Registry (5 chat roles + 1 embedding):
#   default:   infrabrain (this model) — Technical Lead, all CLI/Docker/Nginx tasks
#   strategic: llama3.3:70b            — Strategic Fallback, broad cross-domain reasoning
#   forensic:  deepseek-r1:32b         — Forensic Specialist, deep chain-of-thought debugging
#   worker:    qwen2.5-coder:7b        — Lightweight Worker, fast parallel sub-agent tasks
#   vision:    llama3.2-vision          — Visual Specialist, screenshot/diagram analysis
#   (embed):   bge-m3                   — RAG embeddings (Phase 6 KnowledgeProvider, not chat API)

FROM qwen2.5-coder:32b

# 32k context window — fits comfortably in 32 GB VRAM
# ~18-20 GB model weights (Q4_K_M) + ~8-10 GB KV cache = ~28-31 GB total
# Leaves headroom for BGE-M3 embeddings (~1 GB) when RAG is active
PARAMETER num_ctx 32768

# Low temperature for precise infrastructure diagnostics
# Technical Lead needs deterministic, surgical precision — not creativity
PARAMETER temperature 0.1

# Prevent repetitive diagnostic output
PARAMETER repeat_penalty 1.1

# Stop tokens — prevent runaway generation
PARAMETER stop "<|eot_id|>"
PARAMETER stop "<|end_of_text|>"

# System prompt establishing InfraBrain's role
SYSTEM """You are InfraBrain, an AI IT operations agent. You diagnose infrastructure problems systematically using a Diagnostic Ladder approach. You analyze logs, network topology, and system state to identify root causes. You generate precise, single-command fix steps with risk levels and rollback procedures. You never guess — you verify through evidence. Data provided in TOON format is a token-efficient encoding; parse it as structured data."""
